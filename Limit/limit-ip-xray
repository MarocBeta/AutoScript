function unlock_vmess() {
    cat > /tmp/unlock_vmess_${user}.sh << EOF
#!/bin/bash
sed -i '/#vmess\$/a\### '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json
sed -i '/#vmessgrpc\$/a\### '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json
sed -i "/^### $user $exp $uuid/d" /etc/xray/.lock.db
systemctl restart xray > /dev/null 2>&1
rm -rf /tmp/unlock_vmess_${user}.sh
EOF
    chmod +x /tmp/unlock_vmess_${user}.sh
    echo "/tmp/unlock_vmess_${user}.sh" | at now + 15 minutes
}

