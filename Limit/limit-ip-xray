function cek_lock() {
    cekcek=$(cat /etc/xray/.lock.db)
    if [[ $cekcek == "" ]]; then
        cat >/etc/xray/.lock.db <<EOF
EOF
    else
        echo -ne
    fi
}

function vmip(){
    while true; do
    sleep 15
        cek_lock
        data=( `ls /etc/rs/limit/vmess/ip`);
        for user in "${data[@]}"
        do
            iplimit=$(cat /etc/rs/limit/vmess/ip/$user)
            asu=$(cat /var/log/xray/access.log | grep -wE "$user" | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | sort | uniq);
            cekcek=$(echo -e "$asu" | wc -l);
            
            if [[ $cekcek -gt $iplimit ]]; then
                uuid=$(grep -E "^},{" "/etc/xray/config.json" |  grep -i '"'"${user}"'"' | cut -d " " -f 2 | cut -d '"' -f 2 | uniq )
                exp=$(grep -w "^### $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
                sed -i '/#vmess$/a\### '"$user $exp $uuid"'' /etc/xray/.lock.db
                sed -i "/^### $user $exp/,/^},{/d" /etc/xray/config.json
                echo -n > /var/log/xray/access.log
                systemctl restart xray >> /dev/null 2>&1
                send_log_vmess
                unlock_vmess
            else
                echo -ne
            fi
            sleep 0.1
        done
    done
}

